{
  "name": "@fasrun/fasrun-dev-cli",
  "version": "0.0.0",
  "private": true,
  "description": "FASRUN-DEV-CLI: the fasrun command line (alias fas)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "fasrun": "./bin/run.js",
    "fas": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/help.ts --format esm --platform node",
    "test": "tsdown src/index.ts src/help.ts --format esm --platform node && vitest run"
  },
  "oclif": {
    "bin": "fasrun",
    "dirname": "fasrun",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/index.mjs",
      "identifier": "COMMANDS"
    },
    "helpClass": "./dist/help.mjs"
  },
  "dependencies": {
    "@fasrun/cli-templates": "workspace:*",
    "@oclif/core": "5.1.11",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "@fasrun/plugin-spec-common": "workspace:*"
  },
  "devDependencies": {
    "@fasrun/fasrun-portal-web": "workspace:*",
    "@types/node": "24.19.2",
    "tsdown": "0.23.5",
    "vitest": "4.1.12"
  }
}
