{
  "name": "@fasrun/fasrun-portal-web",
  "version": "0.0.0",
  "private": true,
  "description": "FASRUN-PORTAL-WEB: web portal and its static server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "rsbuild build && tsdown src/index.ts --format esm --platform node --out-dir dist/server",
    "start": "node dist/server/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@rsbuild/core": "2.3.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsdown": "0.23.5",
    "vitest": "4.1.12"
  }
}
