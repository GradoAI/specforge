{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@fasrun/fasrun-dev-cli#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    }
  }
}
